# Sao chép file này thành .env và điền giá trị thật vào
# cp .env.example .env

OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Tuỳ chọn: Base URL nếu dùng bên thứ 3 (như https://api.vilao.ai/v1)
# OPENAI_BASE_URL=https://api.vilao.ai/v1

# Tuỳ chọn: đổi model nếu muốn
OPENAI_MODEL=gpt-4o-mini

# SQLite database file
DATABASE_URL=sqlite:///./scriptscout.db
